# Required for Groq generation
GROQ_API_KEY=

# Local Ollama generation
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# Ghost CMS upload (server-side only)
GHOST_URL=
GHOST_ADMIN_API_KEY=
GHOST_API_VERSION=v5.0

# Ghost scheduler worker / internal API
APP_BASE_URL=http://127.0.0.1:3000
SCHEDULE_SECRET=
SCHEDULE_POLL_INTERVAL_MS=60000

# Optional providers
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Stock image search (Pexels -> Pixabay -> Unsplash)
# Pexels:  https://www.pexels.com/api/  — free, no attribution required
# Pixabay: https://pixabay.com/api/docs/ — free, no attribution required
# Unsplash: https://unsplash.com/developers — API key required
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Optional YouTube thumbnails (for issue/news topics)
YOUTUBE_API_KEY=

# Optional AI image fallback (OpenAI Images)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Stable Diffusion — Local WebUI (AUTOMATIC1111 / Forge / ComfyUI)
# SD WebUI 실행 후 접근 가능한 주소를 넣으세요. 없으면 비워두세요.
# 실행 방법: webui-user.bat --api (AUTOMATIC1111 기준)
SD_WEBUI_URL=http://127.0.0.1:7860
SD_MODEL_CHECKPOINT=
SD_SAMPLER=DPM++ 2M Karras
SD_WIDTH=1344
SD_HEIGHT=768
SD_STEPS=20
SD_CFG_SCALE=7
SD_TIMEOUT_MS=120000

# Stable Diffusion — StabilityAI Cloud API (로컬 SD 없을 때 자동 fallback)
# https://platform.stability.ai/account/keys
STABILITY_API_KEY=
STABILITY_ENGINE=stable-image/generate/core

# Image cache TTL (ms)
IMAGE_CACHE_TTL_MS=21600000
